{
    "name": "flowise",
    "version": "3.0.10",
    "description": "Flowiseai Server",
    "main": "dist/index",
    "types": "dist/index.d.ts",
    "bin": {
        "flowise": "./bin/run"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "start": "node ./bin/run",
        "clean": "rimraf dist",
        "nuke": "rimraf dist node_modules .turbo",
        "dev": "nodemon",
        "typeorm": "typeorm-ts-node-commonjs",
        "typeorm:migration-generate": "pnpm typeorm migration:generate -d ./src/utils/typeormDataSource.ts",
        "typeorm:migration-run": "pnpm typeorm migration:run -d ./src/utils/typeormDataSource.ts",
        "typeorm:migration-revert": "pnpm typeorm migration:revert -d ./src/utils/typeormDataSource.ts",
        "watch": "tsc --watch",
        "test": "jest --runInBand --detectOpenHandles --forceExit"
    },
    "keywords": [],
    "homepage": "https://flowiseai.com",
    "author": {
        "name": "Henry Heng",
        "email": "henryheng@flowiseai.com"
    },
    "engines": {
        "node": ">=18.15.0 <19.0.0 || ^20"
    },
    "license": "SEE LICENSE IN LICENSE.md",
    "dependencies": {
        "@types/lodash": "^4.17.20",
        "@types/uuid": "^9.0.7",
        "archiver": "^6.0.1",
        "async-mutex": "^0.4.0",
        "axios": "1.12.0",
        "content-disposition": "0.5.4",
        "cors": "^2.8.5",
        "crypto-js": "^4.1.1",
        "dotenv": "^16.0.0",
        "express": "^4.17.3",
        "express-basic-auth": "^1.2.1",
        "express-rate-limit": "^6.9.0",
        "flowise-ui": "workspace:^",
        "form-data": "^4.0.0",
        "http-errors": "^2.0.0",
        "http-status-codes": "^2.3.0",
        "https-proxy-agent": "^7.0.4",
        "@langchain/core": "^1.1.15",
        "@langchain/langgraph": "^0.0.15",
        "langchainhub": "^0.0.11",
        "lodash": "^4.17.21",
        "mammoth": "^1.11.0",
        "moment": "^2.29.3",
        "moment-timezone": "^0.5.34",
        "multer": "^2.0.2",
        "mysql2": "^3.11.3",
        "pg": "^8.11.1",
        "pdf-parse": "^1.1.1",
        "reflect-metadata": "^0.1.13",
        "sanitize-html": "^2.11.0",
        "socket.io": "^4.6.1",
        "sqlite3": "^5.1.6",
        "typeorm": "^0.3.6",
        "uuid": "^9.0.1",
        "winston": "^3.9.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@types/archiver": "^6.0.2",
        "@types/content-disposition": "0.5.8",
        "@types/cors": "^2.8.12",
        "@types/crypto-js": "^4.1.1",
        "@types/express": "^4.17.17",
        "@types/multer": "^1.4.7",
        "@types/sanitize-html": "^2.9.5",
        "concurrently": "^7.1.0",
        "cypress": "^13.13.0",
        "nodemon": "^2.0.22",
        "rimraf": "^5.0.5",
        "run-script-os": "^1.1.6",
        "shx": "^0.3.3",
        "start-server-and-test": "^2.0.3",
        "ts-node": "^10.7.0",
        "tsc-watch": "^6.0.4",
        "typescript": "^5.4.5"
    }
}
